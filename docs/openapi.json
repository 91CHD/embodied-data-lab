  "components": {
    "schemas": {
      "CheckpointCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "source": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Source"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "checksum": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "source"
        ],
        "title": "CheckpointCreate"
      },
      "DatasetImport": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "path": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Path"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "local",
              "public",
              "synthetic_demo"
            ],
            "title": "Source Kind",
            "default": "local"
          },
          "source_uri": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Uri"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "path",
          "idempotency_key"
        ],
